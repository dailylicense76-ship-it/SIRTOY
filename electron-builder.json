{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.sirtoy.lendingplus",
  "productName": "Lending Management System",
  "copyright": "Copyright © 2026 Lending Management System",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron-main.cjs",
    "public/**/*"
  ],
  "extraMetadata": {
    "main": "electron-main.cjs",
    "description": "LENDING MANAGEMENT SYSTEM - Offline Desktop Lending Management System",
    "author": "Lending Management System"
  },
  "publish": [
    {
      "provider": "github"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon-512.png",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Lending Management System",
    "license": "license.txt",
    "installerLanguages": ["en_US"],
    "runAfterFinish": true
  }
}
