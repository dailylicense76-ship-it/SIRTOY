{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.sirtoy.lendingplus",
  "productName": "Sirtoy Lending Plus",
  "copyright": "Copyright © 2026 Sirtoy Lending",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron-main.cjs",
    "public/**/*"
  ],
  "extraMetadata": {
    "main": "electron-main.cjs",
    "description": "SIRTOY LENDING PLUS - Offline Desktop Lending Management System",
    "author": "Sirtoy Lending"
  },
  "publish": [
    {
      "provider": "github"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon-512.png",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sirtoy Lending Plus"
  }
}
